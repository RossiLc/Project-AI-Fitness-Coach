NODE_ENV=development

API_PORT=13100
WEB_PORT=15173
VITE_API_BASE_URL=http://127.0.0.1:13100

DATABASE_URL=postgresql://openfit:openfit@localhost:15432/openfit?schema=public
REDIS_URL=redis://localhost:16380

LOCAL_STORAGE_ROOT=./storage/uploads

MOCK_AUTH_ENABLED=true

# AI / GPT provider
# AI 教练不使用模拟回复；配置 URL/key 后调用真实模型，未配置时提示 AI 服务尚未配置。
# AI_MOCK_MODE 仅用于打卡解析、图片识别等开发降级链路。
AI_MOCK_MODE=true
AI_PROVIDER=openai-compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-5.5

# 本地轻量安全围栏
# 第一阶段使用 @andersmyrmel/vard + 中文规则 + 敏感词/PII/Secret 检测，不需要单独部署服务。
GUARDRAIL_PROVIDER=local
LOCAL_GUARDRAIL_ENGINES=vard,sensitive-word-tool
LOCAL_GUARDRAIL_FAIL_CLOSED=true
LOCAL_GUARDRAIL_MAX_INPUT_LENGTH=3000
LOCAL_GUARDRAIL_EXTRA_WORDS=

# 企业微信群机器人出站消息
WECOM_MOCK_MODE=true
WECOM_BOT_WEBHOOK_URL=

# 企业微信智能机器人入站
# 使用 SDK 长连接：配置两个智能机器人的 Bot ID + Secret 即可。
WECOM_INTELLIGENT_BOT_WS_URL=
WECOM_INTELLIGENT_BOT_ID=
WECOM_CHECKIN_BOT_ID=
WECOM_CHECKIN_BOT_SECRET=
WECOM_COACH_BOT_ID=
WECOM_COACH_BOT_SECRET=

# 企业微信自建应用，后续 OAuth、userid 绑定和应用消息使用。
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_APP_SECRET=
WECOM_APP_CALLBACK_URL=http://127.0.0.1:13100/api/auth/wecom/callback
