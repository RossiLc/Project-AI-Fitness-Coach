# ==============================================================================
# 基础运行环境
# ==============================================================================

# 当前运行环境。开发环境保持 development；测试环境通常由测试命令临时覆盖为 test。
NODE_ENV=development


# ==============================================================================
# 服务端口与前端访问地址
# ==============================================================================

# API 服务监听端口。Docker 和本地开发默认暴露 http://localhost:13100。
API_PORT=13100

# Web 工作台监听端口。Docker 和本地开发默认暴露 http://localhost:15173。
WEB_PORT=15173

# Web 前端访问 API 的地址。本地 pnpm dev 时使用；Docker nginx 反向代理时通常不需要修改。
VITE_API_BASE_URL=http://127.0.0.1:13100


# ==============================================================================
# 基础设施：数据库、Redis、本地文件存储
# ==============================================================================

# PostgreSQL 连接串。本地直连使用 localhost:15432；Docker Compose 容器内会覆盖为 postgres:5432。
DATABASE_URL=postgresql://openfit:openfit@localhost:15432/openfit?schema=public

# Redis 连接串。用于 BullMQ 队列、异步任务和部分缓存；Docker Compose 容器内会覆盖为 redis:6379。
REDIS_URL=redis://localhost:16380

# 本地文件存储根目录。企业微信打卡图片会保存到该目录下，数据库只保存相对路径。
LOCAL_STORAGE_ROOT=./storage/uploads


# ==============================================================================
# AI Provider：OpenAI-compatible GPT-5.5
# ==============================================================================

# OpenAI-compatible 模型服务地址。AI 教练和企业微信图片/图文打卡识别共用该地址，通常形如 https://your-ai-host/v1。
AI_BASE_URL=

# OpenAI-compatible 模型服务密钥。只写入本地 .env 或部署密钥，不要提交真实 key。
AI_API_KEY=

# 模型名称。当前按你的要求预留 GPT-5.5；图片打卡需要模型服务支持多模态 image_url 输入。
AI_MODEL=gpt-5.5


# ==============================================================================
# 本地安全围栏
# ==============================================================================

# 本地安全围栏允许处理的最大输入长度，超过后会被安全策略拒绝或截断处理。
LOCAL_GUARDRAIL_MAX_INPUT_LENGTH=3000

# 额外敏感词/违禁词，英文逗号分隔。会叠加到内置敏感词表，用于企业自定义内容安全策略。
LOCAL_GUARDRAIL_EXTRA_WORDS=


# ==============================================================================
# 企业微信智能机器人：长连接入站 + 主动群推送
# ==============================================================================

# 可选：企业微信智能机器人 WebSocket 地址。一般留空使用 SDK 默认地址；只有企业微信官方要求指定特殊地址时再填写。
WECOM_INTELLIGENT_BOT_WS_URL=

# Open Fit 打卡助手的智能机器人 Bot ID。负责接收图片/图文打卡消息、创建打卡记录，并作为后台群提醒的主动推送通道。
WECOM_CHECKIN_BOT_ID=

# Open Fit 打卡助手的智能机器人 Secret。与 Bot ID 配套使用，用于建立 SDK 长连接。
WECOM_CHECKIN_BOT_SECRET=

# Open Fit AI 教练的智能机器人 Bot ID。负责训练建议、活动规则和排行榜查询，不创建打卡记录。
WECOM_COACH_BOT_ID=

# Open Fit AI 教练的智能机器人 Secret。与 Bot ID 配套使用，用于建立 SDK 长连接。
WECOM_COACH_BOT_SECRET=
