{
  "name": "@openfit/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/apps/api/src/main.js",
    "build": "nest build",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev:db:generate": "node ../../scripts/run-with-root-env.mjs prisma generate",
    "dev:db:push": "node ../../scripts/run-with-root-env.mjs prisma db push",
    "dev:db:seed": "node ../../scripts/run-with-root-env.mjs tsx prisma/seed.ts"
  },
  "dependencies": {
    "@andersmyrmel/vard": "^1.2.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@openfit/shared": "workspace:*",
    "@prisma/client": "^6.1.0",
    "@wecom/aibot-node-sdk": "^1.0.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sensitive-word-tool": "^1.1.10"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.8",
    "@nestjs/testing": "^10.4.15",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
